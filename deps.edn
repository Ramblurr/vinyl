{:paths   ["src" "resources"]
 :deps    {uk.co.caprica/vlcj          {:mvn/version "4.11.0"}
           metosin/malli               {:mvn/version "0.19.1"}
           camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}}
 :aliases {:dev    {:extra-deps  {}
                    :extra-paths ["env/dev/clj" "env/dev/resources" "test"]
                    :jvm-opts    ["-Djdk.attach.allowAttachSelf" ;; https://nrepl.org/nrepl/installation.html#jvmti
                                  "-Dguardrails.enabled=true"
                                  "--add-opens=java.base/java.nio=ALL-UNNAMED"
                                  "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"]}
           :kaocha {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                    :main-opts  ["-m" "kaocha.runner"]}
           :build  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.13"}
                                 slipset/deps-deploy           {:mvn/version "0.2.2"}}
                    :ns-default build}
           :neil   {:project {:name        io.github.ramblurr/vinyl
                              :url         "https://github.com/ramblurr/vinyl"
                              :license     {:id "EUPL-1.2"}
                              :description "A small headless audio player for Clojure powered by VLC."
                              :version     "0.1"}}}}
